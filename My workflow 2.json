    {
      "parameters": {
        "jsCode": "const labels = $('Get many labels').all().map(i => i.json);\n\nconst out = $('Message a model').first().json;\nconst raw = out.content?.parts?.[0]?.text ?? out.text ?? out.output ?? '';\nconst name = String(raw).trim().replace(/^[\"'\\s]+|[.\"'\\s]+$/g, '');\n\nconst match = labels.find(l => l.name.toLowerCase() === name.toLowerCase());\nconst fallback = labels.find(l => l.name === 'AI-Inbox');\n\nreturn [{\n  json: {\n    geminiSaid: name,\n    matched: !!match,\n    labelId: (match || fallback || {}).id || null,\n    messageId: $('Gmail Trigger').first().json.id\n  }\n}];"
      },
